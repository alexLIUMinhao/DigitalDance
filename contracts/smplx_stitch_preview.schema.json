    "manifest_id": {"type": "string"},
    "plan_id": {"type": "string"},
    "song_id": {"type": ["string", "null"]},
    "library_id": {"type": "string"},
    "fps": {"type": "integer"},
    "mesh_backend": {"type": "string"},
    "blend_policy": {"type": "object"},
    "scene": {"type": "object"},
    "steps": {"type": "array"},
    "transitions": {"type": "array"},
    "cache_requests": {"type": "array"},
    "notes": {"type": "array"},
    "generated_at_utc": {"type": "string"}
  }
}
