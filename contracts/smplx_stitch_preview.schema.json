  "title": "smplx_stitch_preview",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "plan_id",
    "library_id",
    "fps",
    "mesh_backend",
    "steps",
    "cache_requests",
    "generated_at_utc"
  ],
